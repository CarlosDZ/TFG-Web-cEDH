JWT_SECRET_KEY_MIDDLEWARE=put_here_your_secret_key(can_be_aleatory)
# Generate with: openssl rand -base64 32
PASSWORD_PEPPER=put_here_a_random_pepper
MONGODB_URL=put_here_your_url_to_a_mongodb_database
BACKEND_PORT=put_here_the_port_you_want_to_run_the_backend_on
BACKEND_HOST=put_here_the_direction_of_the_backend's_host
FRONTEND_PORT=iykyk

# Public URL where the frontend is served (used to build email verification links)
APP_URL=https://your-domain.example

# SMTP (Resend example) — used to send account verification emails
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=put_here_your_resend_api_key
SMTP_FROM=no-reply@your-domain.example
--remove this line and the ".example" from the title of this file before using it
